# Copy to .env and fill in. .env is gitignored — never commit real values.

# Anthropic API key. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Finnhub API key (free tier). https://finnhub.io/register
FINNHUB_API_KEY=

# Required by SEC EDGAR on every request — must identify a real contact.
# Requests without a User-Agent are rejected with HTTP 403.
EDGAR_USER_AGENT="Asset-Researcher research tool contact@example.com"
